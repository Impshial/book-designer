{"format":"book-designer","version":1,"id":"eba40805-865a-4039-88a5-403527b30dd4","revision":0,"created":"2026-10-14T20:10:18.236Z","modified":"2026-10-14T20:10:18.236Z","title":"A Garden Between Chapters","author":"Book Designer","language":"en","description":"","style":"hybrid","setup":{"width":432,"height":648,"unit":"in","top":36,"bottom":36,"inside":36,"outside":36,"gutter":0,"bleed":0,"numbering":true,"numberPosition":"center","facing":false},"pages":[{"id":"49ee0d7a-b899-423b-b5a8-9eb63f8031a0","name":"A quiet interlude","background":"#edf1df","objects":[{"id":"39979811-61c5-41a9-a1b9-86a1a2fa125e","name":"Text box","type":"text","x":50,"y":210,"width":330,"height":180,"rotation":0,"opacity":1,"fill":"#263e38","stroke":"#526c61","strokeWidth":0,"locked":false,"hidden":false,"text":"Every garden holds\na door to somewhere.","font":"serif","fontSize":26,"bold":false,"italic":true,"align":"center","lineHeight":1.4,"crop":{"x":0,"y":0,"width":1,"height":1},"alt":"","decorative":false,"keepRatio":true}],"readingOrder":["39979811-61c5-41a9-a1b9-86a1a2fa125e"]}],"chapters":[{"id":"09c4e3a7-d5e2-460d-a7ae-7d6d627f3084","title":"Chapter 1","document":{"type":"doc","content":[{"type":"heading","attrs":{"id":"2f8d174e-f01f-4a18-9da5-e5b7899871a1","level":1},"content":[{"type":"text","text":"The little door"}]},{"type":"paragraph","attrs":{"id":"94ddb241-0b8b-4389-a994-d1c3626f8aff"},"content":[{"type":"text","text":"Mira found the little door at the edge of the garden. It was no taller than a teacup, painted the green of new leaves. She crouched beside it and listened. On the other side, someone was humming a song she almost remembered."}]},{"type":"paragraph","attrs":{"id":"f19e9ae4-fc32-4feb-b365-bfd0964c91d8"},"content":[{"type":"text","text":"Mira found the little door at the edge of the garden. It was no taller than a teacup, painted the green of new leaves. She crouched beside it and listened. On the other side, someone was humming a song she almost remembered."}]