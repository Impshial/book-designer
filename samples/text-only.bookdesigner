{"format":"book-designer","version":1,"id":"e5093b03-e70d-4a0e-bcdf-28adfa652e05","revision":0,"created":"2026-10-14T20:10:18.231Z","modified":"2026-10-14T20:10:18.231Z","title":"The Little Door","author":"Book Designer","language":"en","description":"","style":"text","setup":{"width":432,"height":648,"unit":"in","top":36,"bottom":36,"inside":36,"outside":36,"gutter":0,"bleed":0,"numbering":true,"numberPosition":"center","facing":false},"pages":[],"chapters":[{"id":"56432537-eb25-4e57-a7dc-f3b31054ee04","title":"The little door","document":{"type":"doc","content":[{"type":"heading","attrs":{"id":"be65b65a-a4c4-4d73-bc05-79e35b024ad6","level":1},"content":[{"type":"text","text":"The little door"}]},{"type":"paragraph","attrs":{"id":"ce6c929b-4613-4312-85e3-292e1a7e33e2"},"content":[{"type":"text","text":"Mira found the little door at the edge of the garden. It was no taller than a teacup, painted the green of new leaves. She crouched beside it and listened. On the other side, someone was humming a song she almost remembered."}]},{"type":"paragraph","attrs":{"id":"57737a0d-b228-414e-a706-ff187f8f3651"},"content":[{"type":"text","text":"Mira found the little door at the edge of the garden. It was no taller than a teacup, painted the green of new leaves. She crouched beside it and listened. On the other side, someone was humming a song she almost remembered."}]},{"type":"paragraph","attrs":{"id":"052b2cd1-d170-4d02-9cdf-91004a495f9d"},"content":[{"type":"text","text":"Mira found the little door at the edge of the garden. It was no taller than a teacup, painted the green of new leaves. She crouched beside it and listened. On the other side, someone was humming a song she almost remembered."}]},{"type":"paragraph","attrs":{"id":"6aecfb65-6854-4cf2-84c8-d5aebbb2b590"},"content":[{"type":"text","text":"Mira found the little door at the edge of the garden. It was no taller than a teacup, painted the green of new leaves. She crouched beside it and listened. On the other side,